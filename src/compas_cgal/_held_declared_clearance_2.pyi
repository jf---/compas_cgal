"""Native exact clearance of Held path elements against the declared (Pythagorean) boundary.

Mirrors src/held_declared_clearance_2/bindings_2.cpp. Rationals cross as
``(numerator, denominator)`` decimal text, one-root numbers as
``(rational, coefficient, radicand)`` triples of those. Binary64 lanes take
floats, injected exactly. Each verdict is ``(clearance, primitive, depth)``:
clearance -1 GOUGE, 0 TOUCH, 1 CLEAR; primitive -1 when CLEAR; depth a
reported binary64 (never a decision).
"""

from collections.abc import Sequence
from typing import TypeAlias

_RationalWire: TypeAlias = tuple[str, str]
_RootWire: TypeAlias = tuple[_RationalWire, _RationalWire, _RationalWire]
_PointWire: TypeAlias = tuple[_RootWire, _RootWire]
# (kind, sense, rationals): a line (0, 0, [sx, sy, ex, ey, ux, uy, length]); an arc
# (1, sense, [sx, sy, ex, ey, cx, cy, radius]).
_PrimitiveWire: TypeAlias = tuple[int, int, Sequence[_RationalWire]]
# (kind, sense, owners, start, end, rationals): a segment (0, 0, owners, s, e,
# [dx, dy, nx, ny, level]); an arc (1, sense, owners, s, e, [cx, cy, radius]).
_ElementWire: TypeAlias = tuple[int, int, Sequence[int], _PointWire, _PointWire, Sequence[_RationalWire]]
_VerdictWire: TypeAlias = tuple[int, int, float]

class DeclaredClearanceError(ValueError): ...
class InvalidDeclaredPrimitiveError(DeclaredClearanceError): ...
class NonPositiveClearanceRadiusError(DeclaredClearanceError): ...
class DegenerateClearanceElementError(DeclaredClearanceError): ...
class NegativeRadicandError(DeclaredClearanceError): ...
class CrossRootArithmeticError(DeclaredClearanceError): ...
class MixedRootPointError(DeclaredClearanceError): ...
class InvalidClearanceWireError(DeclaredClearanceError): ...
class ReportingOverflowError(DeclaredClearanceError): ...

def last_counters() -> tuple[int, int, int, int]:
    """``(elements, pairs, owner_touches, crossings)`` of the last batch (reported only)."""

class DeclaredClearance2:
    @staticmethod
    def build(primitives: Sequence[_PrimitiveWire], tool_radius: _RationalWire) -> DeclaredClearance2: ...
    @property
    def primitive_count(self) -> int: ...
    def circles_binary64(self, xs: Sequence[float], ys: Sequence[float], radii: Sequence[float]) -> list[_VerdictWire]: ...
    def segments_binary64(self, x0: Sequence[float], y0: Sequence[float], x1: Sequence[float], y1: Sequence[float]) -> list[_VerdictWire]: ...
    def elements(self, elements: Sequence[_ElementWire]) -> list[_VerdictWire]: ...
